# Molecule Radar configuration contract.
# Copy to backend/.env for local development. Never commit a filled-in copy.

MR_ENVIRONMENT=development

# ---- Database -------------------------------------------------------------
MR_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/moleculeradar

# ---- Raw payload storage --------------------------------------------------
# filesystem is fine locally; production must use durable object storage.
MR_RAW_STORAGE_BACKEND=filesystem
MR_RAW_STORAGE_PATH=./var/raw
# MR_RAW_STORAGE_BUCKET=moleculeradar-raw

# ---- Outbound HTTP --------------------------------------------------------
# REQUIRED before any ingestion run. Several public APIs (NCBI E-utilities,
# Crossref) treat a contactable user agent as a condition of polite use, and
# ingestion refuses to start without it.
MR_HTTP_CONTACT_EMAIL=
MR_HTTP_REQUESTS_PER_SECOND=2.0

# ---- Optional source credentials (raise rate limits; not required) --------
# MR_OPENFDA_API_KEY=
# MR_NCBI_API_KEY=

# ---- Focus company --------------------------------------------------------
MR_FOCUS_COMPANY_NAME=Dr. Reddy's Laboratories

# ---- Entity resolution thresholds ----------------------------------------
MR_ER_AUTO_ACCEPT_THRESHOLD=0.95
MR_ER_REVIEW_FLOOR_THRESHOLD=0.80

# ---- Security -------------------------------------------------------------
# Generate with: openssl rand -hex 32
MR_JWT_SECRET=
MR_AUTH_ENABLED=true
MR_RATE_LIMIT_PER_MINUTE=120

# ---- LLM (optional; disabled by default) ---------------------------------
# The product works without an LLM. Enabling it adds investigation synthesis
# and document extraction, never fact determination.
MR_LLM_ENABLED=false
# MR_ANTHROPIC_API_KEY=
MR_LLM_MODEL=claude-sonnet-5-5
