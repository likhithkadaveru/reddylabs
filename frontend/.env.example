# Frontend configuration. The API is the only backend; no secret is ever
# bundled into the client because all fetching happens in server components.

MR_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Bearer token used for server-side API calls when MR_AUTH_ENABLED=true on the
# backend. Leave unset for local development with auth disabled.
# MR_API_TOKEN=
